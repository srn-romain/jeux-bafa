rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FONCTIONS UTILITAIRES
    // ============================================================

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() && userDoc().role == 'admin' && request.auth.uid == "htY99Hx1OgTZDDbwfgeLgMw2n6B3";
    }

    function hasApprovedAccess(espaceId) {
      return isAuth() &&
             exists(/databases/$(database)/documents/accessRequests/$(request.auth.uid + '_' + espaceId)) &&
             get(/databases/$(database)/documents/accessRequests/$(request.auth.uid + '_' + espaceId)).data.status == 'approved';
    }

    // ============================================================
    // COLLECTION : users
    // ============================================================
    match /users/{userId} {
      // Pour permettre à la page "Equipe d'animation" de charger le profil des autres animateurs
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId && request.resource.data.role == 'anim';
      allow update: if isAuth() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ============================================================
    // COLLECTION : espaces
    // ============================================================
    match /espaces/{espaceId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        hasApprovedAccess(espaceId) && (
          // Les anims simples peuvent modifier UNIQUEMENT les commentaires et le verrou d'édition
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentaires', 'commentEditingBy', 'commentEditingByName', 'commentEditingAt']) ||
          // Les directeurs (anim-admin) peuvent également modifier les paramètres de la colo (météo, photos, IA, verrous, etc.)
          (
            get(/databases/$(database)/documents/accessRequests/$(request.auth.uid + '_' + espaceId)).data.get('espaceRole', 'anim') == 'anim-admin' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentaires', 'commentEditingBy', 'commentEditingByName', 'commentEditingAt', 'meteoLocation', 'meteoLocationName', 'meteoLat', 'meteoLon', 'photoUploadEnabled', 'allowAnimAI', 'nbParticipants', 'participantsLocked'])
          )
        )
      );

      // ---- Sous-collection : participants ----
      match /participants/{participantId} {
        allow read: if isAdmin() || hasApprovedAccess(espaceId);
        allow create, delete: if isAdmin() || (
          hasApprovedAccess(espaceId) &&
          get(/databases/$(database)/documents/espaces/$(espaceId)).data.get('participantsLocked', false) == false
        );
        allow update: if isAdmin() || (
          hasApprovedAccess(espaceId) && (
            get(/databases/$(database)/documents/espaces/$(espaceId)).data.get('participantsLocked', false) == false ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note'])
          )
        );
      }

      // ---- Sous-collection : groups ----
      match /groups/{groupId} {
        allow read: if isAdmin() || hasApprovedAccess(espaceId);
        allow create, update, delete: if isAdmin();
      }

      // ---- Sous-collection : alerts ----
      match /alerts/{alertId} {
        allow read, create, update: if isAdmin() || hasApprovedAccess(espaceId);
        allow delete: if isAdmin() || (
          hasApprovedAccess(espaceId) &&
          resource.data.get('locked', false) == false
        );
      }

      // ---- Sous-collection : photos ----
      match /photos/{photoId} {
        allow read: if isAdmin() || hasApprovedAccess(espaceId);
        allow create: if isAdmin() || (
          hasApprovedAccess(espaceId) &&
          get(/databases/$(database)/documents/espaces/$(espaceId)).data.get('photoUploadEnabled', false) == true &&
          request.resource.data.authorId == request.auth.uid
        );
        allow update: if false;
        allow delete: if isAdmin() || (
          hasApprovedAccess(espaceId) &&
          resource.data.authorId == request.auth.uid
        );
      }
    }

    // ============================================================
    // COLLECTION : accessRequests
    // ============================================================
    match /accessRequests/{requestId} {
      allow read: if isAuth();
      allow create: if (isAuth()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasAll(['userId', 'espaceId', 'status']))
                    || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // COLLECTION : globalSettings
    // ============================================================
    match /globalSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // REFUS PAR DÉFAUT
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
