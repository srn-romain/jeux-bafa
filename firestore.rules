rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FONCTIONS UTILITAIRES
    // ============================================================

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             userDoc().get('role', 'anim') == 'admin' &&
             userDoc().get('isBanned', false) == false &&
             userDoc().get('banned', false) == false;
    }

    function isFormateur() {
      return isAuth() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             userDoc().get('role', 'anim') == 'formateur' &&
             userDoc().get('isBanned', false) == false &&
             userDoc().get('banned', false) == false;
    }

    function isNotBanned() {
      return isAuth() &&
             (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
              (userDoc().get('isBanned', false) == false && userDoc().get('banned', false) == false));
    }

    function hasApprovedAccess(espaceId) {
      return isAuth() &&
             isNotBanned() &&
             exists(/databases/$(database)/documents/accessRequests/$(request.auth.uid + '_' + espaceId)) &&
             get(/databases/$(database)/documents/accessRequests/$(request.auth.uid + '_' + espaceId)).data.get('status', '') == 'approved';
    }

    function isEspaceAdmin(espaceId) {
      return isAdmin() || (
        hasApprovedAccess(espaceId) &&
        get(/databases/$(database)/documents/accessRequests/$(request.auth.uid + '_' + espaceId)).data.get('espaceRole', 'anim') == 'anim-admin'
      );
    }

    // ============================================================
    // COLLECTION : users
    // ============================================================
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isNotBanned());
      allow create: if isAuth()
                    && request.auth.uid == userId
                    && request.resource.data.get('role', 'anim') in ['anim', 'stagiaire', 'formateur']
                    && request.resource.data.get('isBanned', false) == false
                    && request.resource.data.get('banned', false) == false;
      allow update: if isAuth() && (
        (request.auth.uid == userId
         && isNotBanned()
         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned', 'banned', 'geminiKey']))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ============================================================
    // COLLECTION : espaces
    // ============================================================
    match /espaces/{espaceId} {
      // Lecture de la fiche de base de la colo pour le dashboard d'accueil
      allow read: if isAuth() && isNotBanned();
      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        hasApprovedAccess(espaceId) && (
          (
            resource.data.get('commentsLocked', false) == false &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentaires', 'commentEditingBy', 'commentEditingByName', 'commentEditingAt', 'updatedAt'])
          ) ||
          (
            isEspaceAdmin(espaceId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'commentaires', 'commentEditingBy', 'commentEditingByName', 'commentEditingAt',
              'meteoLocation', 'meteoLocationName', 'meteoLat', 'meteoLon',
              'photoUploadEnabled', 'allowAnimAI', 'nbParticipants',
              'participantsLocked', 'commentsLocked', 'updatedAt'
            ])
          )
        )
      );

      // ---- SOUS-COLLECTIONS VERROUILLÉES (Participants / Photos / Alertes / Groupes) ----
      match /participants/{participantId} {
        allow read: if isAdmin() || hasApprovedAccess(espaceId);
        allow create, delete: if isAdmin() || (
          isEspaceAdmin(espaceId) &&
          get(/databases/$(database)/documents/espaces/$(espaceId)).data.get('participantsLocked', false) == false
        );
        allow update: if isAdmin() || (
          hasApprovedAccess(espaceId) && (
            (
              isEspaceAdmin(espaceId) &&
              get(/databases/$(database)/documents/espaces/$(espaceId)).data.get('participantsLocked', false) == false
            ) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'spec', 'updatedAt'])
          )
        );
      }

      match /groups/{groupId} {
        allow read: if isAdmin() || hasApprovedAccess(espaceId);
        allow create, update, delete: if isAdmin() || isEspaceAdmin(espaceId);
      }

      match /alerts/{alertId} {
        allow read, create, update: if isAdmin() || hasApprovedAccess(espaceId);
        allow delete: if isAdmin() || (
          hasApprovedAccess(espaceId) &&
          resource.data.get('locked', false) == false
        );
      }

      match /photos/{photoId} {
        allow read: if isAdmin() || hasApprovedAccess(espaceId);
        allow create: if isAdmin() || (
          hasApprovedAccess(espaceId) &&
          get(/databases/$(database)/documents/espaces/$(espaceId)).data.get('photoUploadEnabled', false) == true &&
          request.resource.data.authorId == request.auth.uid
        );
        allow update: if false;
        allow delete: if isAdmin() || (
          hasApprovedAccess(espaceId) &&
          resource.data.authorId == request.auth.uid
        );
      }
    }

    // ============================================================
    // COLLECTION : accessRequests
    // ============================================================
    match /accessRequests/{requestId} {
      allow read: if isAuth() && isNotBanned();
      allow create: if isAdmin() || (
        isAuth()
        && isNotBanned()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['userId', 'espaceId', 'status'])
      );
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // COLLECTION : globalSettings
    // ============================================================
    match /globalSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // COLLECTION : formation (Modules, Quiz & Questions)
    // ============================================================
    match /formation/{moduleId} {
      allow read: if isAuth() && isNotBanned();
      allow create, update, delete: if isAdmin();

      // Sous-collection des questions du module
      match /questions/{questionId} {
        allow read: if isAuth() && isNotBanned();
        allow create, update, delete: if isAdmin();
      }

      // Sous-collection des réponses / soumissions des stagiaires (support multi-tentatives)
      match /submissions/{submissionId} {
        allow read: if isAdmin() || isFormateur() || (isAuth() && (resource == null || resource.data.userId == request.auth.uid));
        allow create: if isAuth() && isNotBanned() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuth() && isNotBanned() && (
          isAdmin() ||
          isFormateur() ||
          (request.resource.data.userId == request.auth.uid && (resource == null || resource.data.userId == request.auth.uid))
        );
        allow delete: if isAdmin();
      }
    }

    // ============================================================
    // COLLECTION : formationModules (Alias / compatibilité)
    // ============================================================
    match /formationModules/{moduleId} {
      allow read: if isAuth() && isNotBanned();
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // COLLECTION : formationSubmissions (Alias / compatibilité)
    // ============================================================
    match /formationSubmissions/{submissionId} {
      allow read: if isAdmin() || isFormateur() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && isNotBanned() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && isNotBanned() && (
        isAdmin() ||
        isFormateur() ||
        (request.resource.data.userId == request.auth.uid && resource.data.userId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // ============================================================
    // COLLECTIONS : Votes
    // ============================================================
    match /positive_votes/{voteId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['count', 'voters']);
      allow delete: if isAdmin();
    }

    match /negative_votes/{voteId} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['count', 'voters']);
      allow delete: if isAdmin();
    }

    // ============================================================
    // REFUS PAR DÉFAUT
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
